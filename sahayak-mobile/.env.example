# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit a real API key.
# Restart `npx expo start` after changing any value here.

# true = fake transcript (no network). false = real speech-to-text via Groq.
EXPO_PUBLIC_USE_MOCK_STT=true

# Free key from https://console.groq.com/keys (only needed when USE_MOCK_STT is false)
EXPO_PUBLIC_GROQ_API_KEY=

# true = built-in fake backend (login, profile and chat all faked).
# false = call the real backend at API_BASE_URL (needs a real account).
EXPO_PUBLIC_USE_MOCK_API=true

# Real backend root, no trailing slash. The deployed demo backend is
# https://sahayak-ai-q5ee.onrender.com (a local one: http://<laptop-LAN-IP>:8000).
# Must be https:// for release builds. Only needed when USE_MOCK_API is false.
EXPO_PUBLIC_API_BASE_URL=
