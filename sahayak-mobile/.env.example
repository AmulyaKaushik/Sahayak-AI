# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit a real API key.
# Restart `npx expo start` after changing any value here.

# true = fake transcript (no network). false = real speech-to-text via Groq.
EXPO_PUBLIC_USE_MOCK_STT=true

# Free key from https://console.groq.com/keys (only needed when USE_MOCK_STT is false)
EXPO_PUBLIC_GROQ_API_KEY=
