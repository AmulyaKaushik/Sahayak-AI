# Copy to .env (never commit .env). See ../connect.md section 4.1.
DATABASE_URL=postgresql://sahayak:sahayak@localhost:5432/sahayak   # cloud: Neon/Supabase pooled URL, ?sslmode=require
REDIS_URL=redis://localhost:6379/0                                  # cloud: Upstash rediss://...
GROQ_API_KEY=
GROQ_API_KEYS=                   # optional: more Groq keys, comma separated (used round-robin)
JWT_SECRET=                      # python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=                   # protects /api/v1/admin/* and /health/deps
EMBEDDING_API_KEY=               # Gemini API key, for RAG
AUTO_SETUP=false                 # true on Render: migrate + seed rules + sync documents/ on start
ENABLE_DEBUG_ROUTES=false        # true only for local dev / the legacy tests
